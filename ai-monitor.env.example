# AI Monitor + Sellbird configuration
# Set these in your secret manager or untracked .env. Never commit credentials.
HERCULES_BASE_URL=https://ai-monitor-crm-088266.onhercules.app
HERCULES_API_TOKEN=
HERCULES_CONTACTS_PATH=/api/contacts
HERCULES_COMPANIES_PATH=/api/companies
HERCULES_OPPORTUNITIES_PATH=/api/opportunities
HERCULES_RETRIES=3
# Optional JSON mapping of Sellbird field names to Hercules API field names.
HERCULES_FIELD_MAPPING={}
# Contact-source/provenance is recorded on each prospect. Configure discovery
# provider credentials as needed; Microsoft OAuth follows docs/microsoft365.md.
